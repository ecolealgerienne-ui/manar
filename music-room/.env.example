# Copy to .env (git-ignored) and fill in. NEVER commit real values.
PORT=4000
# Required in production: long random string (used to HMAC-hash tokens)
TOKEN_SECRET=change-me-with-openssl-rand-hex-32
DB_PATH=./data/musicroom.db
# Public URL of the backend (used in e-mail links)
PUBLIC_URL=http://localhost:4000
# SMTP (optional: without it, mails are printed in the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Music Room <no-reply@musicroom.local>
# Social login (comma-separated Google OAuth client IDs: web, android, ios)
GOOGLE_CLIENT_IDS=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Requests / minute / IP and auth attempts / 15 min / IP
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
CORS_ORIGINS=*
