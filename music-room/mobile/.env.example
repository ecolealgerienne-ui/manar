# Copy to .env (git-ignored)
# Default backend address (changeable at runtime in the app: Settings). On a real phone use your computer's LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Social login (public OAuth client IDs from console.cloud.google.com / developers.facebook.com)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_FACEBOOK_APP_ID=
