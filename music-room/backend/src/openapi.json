{
 "openapi": "3.0.3",
 "info": {
  "title": "Music Room API",
  "version": "1.0.0",
  "description": "REST/JSON API. Real time: WebSocket /ws — send {\"action\":\"auth\",\"token\"} then {\"action\":\"subscribe\",\"channel\":\"event:1|playlist:1|device:1\"}; server pushes {channel,type:\"state\",data}. Mobile apps should send headers X-Platform, X-Device-Model, X-App-Version (logged server side)."
 },
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer"
   }
  }
 },
 "paths": {
  "/auth/register": {
   "post": {
    "tags": [
     "Auth"
    ],
    "summary": "Create an account with e-mail/password (sends a verification e-mail)",
    "security": [],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "email",
         "password",
         "display_name"
        ],
        "properties": {
         "email": {
          "type": "string"
         },
         "password": {
          "type": "string",
          "minLength": 8
         },
         "display_name": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "201": {
      "description": "Created"
     },
     "400": {
      "description": "Validation error"
     }
    }
   }
  },
  "/auth/verify-email": {
   "get": {
    "tags": [
     "Auth"
    ],
    "summary": "Link received by e-mail: validates the address",
    "security": [],
    "parameters": [
     {
      "name": "token",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK"
     },
     "400": {
      "description": "Validation error"
     }
    }
   }
  },
